{
  "info": {
    "name": "Usuarios - Sprint 7 - SOLO usuarios_test",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Iniciar la fabrica de pruebas en 127.0.0.1:8001. Obtener un JWT de ADMIN mediante login JSON en Swagger e ingresarlo en la variable local no compartida accessToken. No guardar tokens en archivos exportados."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8001"
    },
    {
      "key": "usuarioId",
      "value": ""
    },
    {
      "key": "email",
      "value": ""
    },
    {
      "key": "accessToken",
      "value": ""
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (pm.variables.replaceIn('{{baseUrl}}') !== 'http://127.0.0.1:8001') { throw new Error('Solo se permite la API local de pruebas en 127.0.0.1:8001'); }",
          "if (pm.info.requestName === 'Crear usuario') { pm.collectionVariables.set('email', 'postman.' + pm.variables.replaceIn('{{$guid}}') + '@example.com'); }"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Crear usuario",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/usuarios",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Ana\",\n  \"apellido\": \"Perez\",\n  \"email\": \"{{email}}\",\n  \"rol\": \"USUARIO\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) { pm.collectionVariables.set('usuarioId', pm.response.json().id); }",
              "pm.test('Location presente', () => pm.expect(pm.response.headers.has('Location')).to.be.true);"
            ]
          }
        }
      ]
    },
    {
      "name": "Listar todos",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/usuarios?estado=todos&limite=20&desplazamiento=0"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Obtener usuario",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/usuarios/{{usuarioId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Modificar usuario",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/usuarios/{{usuarioId}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Ana\",\n  \"apellido\": \"Diaz\",\n  \"email\": \"{{email}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Baja logica",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/api/v1/usuarios/{{usuarioId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 204', () => pm.response.to.have.status(204));",
              "pm.test('Sin cuerpo', () => pm.expect(pm.response.text()).to.eql(''));"
            ]
          }
        }
      ]
    },
    {
      "name": "Reactivar usuario",
      "request": {
        "method": "PATCH",
        "header": [],
        "url": "{{baseUrl}}/api/v1/usuarios/{{usuarioId}}/reactivar"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  }
}
